# Cloudflare response headers (copied into build/ by adapter-static).

# Hashed JS/CSS bundles never change under the same name.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate the app shell so a new deploy is picked up.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/_app/version.json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
